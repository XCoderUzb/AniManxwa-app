{
  "name": "animanxwa-desktop",
  "productName": "AniManxwa",
  "version": "1.0.0",
  "description": "AniManxwa - kompyuter uchun ilova",
  "author": "AniManxwa",
  "private": true,
  "main": "main.js",
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.animanxwa.desktop",
    "productName": "AniManxwa",
    "directories": { "output": "dist" },
    "files": ["main.js", "app/**/*"],
    "protocols": [{ "name": "AniManxwa", "schemes": ["animanxwa"] }],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "icon": "app/icon-512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "AniManxwa-Setup-${version}.exe"
    },
    "portable": { "artifactName": "AniManxwa-Portable-${version}.exe" }
  }
}
